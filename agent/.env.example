# NVIDIA API key from https://build.nvidia.com (never commit a real key)
NVIDIA_API_KEY=
# NVIDIA-hosted Nemotron model with tool calling
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PORT=3001
# Max tool-execution rounds per investigation (hard cap 5)
MAX_INVESTIGATION_ROUNDS=5
# Output token cap per model call
MAX_OUTPUT_TOKENS=2048
# Readings older than this (relative to the snapshot's as_of time) are stale
STALE_AFTER_MINUTES=15
# Nemotron reasoning mode (true/false). Reasoning text is never exposed.
NVIDIA_ENABLE_THINKING=false
# --- Multi-agent ---
# Model for Telemetry/Environment/Documentation/Verification agents (blank = NVIDIA_MODEL)
NVIDIA_SPECIALIST_MODEL=
MAX_DELEGATIONS=5
MAX_SPECIALIST_TOOL_ROUNDS=3
MAX_VERIFICATION_RETRIES=1
MAX_INVESTIGATION_SECONDS=90
# Budget when a photo is attached (Vision + mandatory multimodal verification)
MAX_VISUAL_INVESTIGATION_SECONDS=130
# --- Vision (Feature 4) ---
# Multimodal Nemotron for the Vision Agent (text + image input)
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
